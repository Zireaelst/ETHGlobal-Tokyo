# Sui
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Published public object identifiers
COFFER_PACKAGE_ID=
TREASURY_ID=

# World sandbox OIDC; secrets belong only in an untracked local .env
WORLD_OIDC_ISSUER=https://sandbox.auth.world.org
WORLD_OIDC_CLIENT_ID=
WORLD_OIDC_CLIENT_SECRET=
WORLD_OIDC_REDIRECT_URI=http://localhost:3000/api/world/callback
WORLD_OIDC_MAX_AGE_SECONDS=120

# Agent invoice extraction: ollama or anthropic in live environments
INVOICE_EXTRACTOR_MODE=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
ANTHROPIC_API_KEY=

# Local durable worker state
LIBSQL_URL=file:./coffer-worker.db
