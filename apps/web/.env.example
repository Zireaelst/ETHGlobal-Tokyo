NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443

# Browser-safe public values from the Enoki Developer Portal.
# Add both to enable Google zkLogin; omit either to keep standard Sui wallets only.
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stable server-side World authorization gateway. No World secret belongs here.
NEXT_PUBLIC_WORLD_GATEWAY_URL=https://coffer-tokyo-world-gateway.onrender.com

# Optional server-only fresh testnet runner. Add these only in Vercel server
# environment settings; never add NEXT_PUBLIC_ prefixes and never commit values.
COFFER_LIVE_DEMO_ENABLED=false
COFFER_TESTNET_PRIVATE_KEY=
